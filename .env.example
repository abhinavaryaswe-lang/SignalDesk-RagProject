LLM_PROVIDER=cloudflare
## Hosted free-tier inference (create a Workers AI API token in the Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.2-3b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
## Optional local provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=all-minilm
## Optional Hugging Face Inference Providers (credit-based hosted inference)
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: Supabase > Project Settings > Database > Connection string (Session pooler recommended)
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
MAX_UPLOAD_MB=15
